# Base de datos local (predeterminada)
EPH_DATABASE_BACKEND=sqlite
EPH_DATABASE_URL=sqlite:///eph.sqlite

# PostgreSQL administrado (Neon, Supabase u otro)
# EPH_DATABASE_BACKEND=postgresql
# EPH_DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Cloudflare D1 experimental. El token se guarda en otra variable, nunca aquí.
# EPH_DATABASE_BACKEND=cloudflare_d1
# EPH_DATABASE_URL=d1://account-id/database-id
# CLOUDFLARE_D1_TOKEN=

# Perfiles LLM compatibles con OpenAI (ver config/providers.example.yml)
EPH_MODE=local
EPH_DAILY_QUERY_LIMIT=20
# EPH_PROVIDERS_FILE=config/providers.yml
# En modo hosted, hosts remotos permitidos (separados por coma):
# EPH_ALLOWED_LLM_HOSTS=api.example.com

# Claves: el YAML guarda solo el nombre de la variable, nunca el valor.
# EPH_LLM_API_KEY=
# EPH_DEV_API_KEY=
# EPH_EVAL_API_KEY=
